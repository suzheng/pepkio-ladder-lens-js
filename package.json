{
  "name": "pepkio-ladder-lens",
  "version": "0.1.0",
  "description": "Estimate DNA, RNA, and protein band sizes from gel electrophoresis migration distances using semi-log standard curves via the Pepkio Tools REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-ladder-lens": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-ladder-lens-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-ladder-lens-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/ladder-lens",
  "keywords": [
    "ladder-lens",
    "gel-electrophoresis",
    "agarose-gel",
    "sds-page",
    "band-size-estimation",
    "molecular-weight-calibration",
    "relative-mobility",
    "rf-calculation",
    "semi-log-regression",
    "gel-smile-correction",
    "dna-ladder",
    "protein-ladder",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
